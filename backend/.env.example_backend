# Database Configuration
# These values match the Kubernetes Service names 
POSTGRES_HOSTNAME=postgres-service
POSTGRES_PORT=5432
POSTGRES_DB=deliveries_database_k8s
POSTGRES_USER=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=<change_this_password>

# The Database URL uses the internal K8s DNS (postgres-service)
DATABASE_URL=postgresql://postgres:<change_this_password>@postgres-service:5432/deliveries_database_k8s

# Kafka & Schema Registry
# Connecting to services within the cluster
KAFKA_BOOTSTRAP_SERVERS=kafka-service:9092
SCHEMA_REGISTRY_URL=http://schema-registry-service:8081
CLUSTER_ID=<optional_cluster_id>
KAFKA_TOPIC_REQUESTS=delivery_requests
KAFKA_TOPIC_RESULT=delivery_results

# JWT Authentication
SECRET_KEY=<change_this_to_secure_random_key>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs
GOOGLE_API_KEY=<insert_your_google_maps_api_key>