# .env.test.docker - For running services against the test environment

# Database connection for a container 
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=the_test_password
POSTGRES_HOSTNAME=test-db
POSTGRES_PORT=5432
POSTGRES_DB=the_delivery_db_test

#Kafka connection for a container 
KAFKA_BOOTSTRAP_SERVERS=test-kafka:9092
SCHEMA_REGISTRY_URL=http://test-kafka:8081
KAFKA_TOPIC_REQUESTS=delivery_requests_test
KAFKA_TOPIC_RESULT=delivery_results_test

#Application settings
SECRET_KEY=test_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

GOOGLE_API_KEY=<insert_your_google_maps_api_key>